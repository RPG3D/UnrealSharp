<Project Sdk="Microsoft.NET.Sdk">

    <!-- NOTE: deliberately does NOT import UnrealSharp.Shared.props. This is a plugin-internal
         project: everything Shared.props provides (flat Binaries HintPath references + flat
         analyzers) is either supplied here via ProjectReference(-Analyzer) or unwanted. When
         the flat DLLs exist (after any prior managed build) they can be STALER than the
         ProjectReference outputs and shadow them at compile time (missing freshly generated
         namespaces, duplicated generator members → CS0234/CS0111). Upstream CI never sees this
         because it builds from a checkout where the flat copies do not exist yet.
         UnrealSharp.Build.props is imported directly for the WITH_* DefineConstants. -->
    <Import Project="..\..\..\UnrealSharp.AOT.props" Condition="Exists('..\..\..\UnrealSharp.AOT.props')" />
    <Import Project="..\..\..\UnrealSharp.Build.props" Condition="Exists('..\..\..\UnrealSharp.Build.props')" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsPublishable Condition="'$(UETargetType)' != 'Editor'">false</IsPublishable>
        <IsEditorOnly>true</IsEditorOnly>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnrealSharp.Plugins\UnrealSharp.Plugins.csproj" />
        <ProjectReference Include="..\UnrealSharp.SourceGenerator.Utilities\UnrealSharp.SourceGenerator.Utilities.csproj" />
        <ProjectReference Include="..\UnrealSharp.SourceGenerators\UnrealSharp.SourceGenerators.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        
        <ProjectReference Include="..\UnrealSharp.GlueGenerator\UnrealSharp.GlueGenerator\UnrealSharp.GlueGenerator.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        
      <ProjectReference Include="..\UnrealSharp\UnrealSharp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\Managed\Shared\*.cs" Link="..\..\..\Managed\Shared\*.cs" />
    </ItemGroup>
</Project>
