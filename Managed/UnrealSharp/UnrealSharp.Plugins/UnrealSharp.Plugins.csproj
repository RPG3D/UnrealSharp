<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\..\UnrealSharp.AOT.props" Condition="Exists('..\..\..\UnrealSharp.AOT.props')" />
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	    <NoWarn>$(NoWarn);1570;0649;0169;0108;0109</NoWarn>
        <!-- Ensure `dotnet publish <sln>` includes this project. Without IsPublishable,
             the SDK skips it on `publish` (only `build` runs it), so UnrealSharp.Plugins.dll
             (the runtime entry assembly) is missing from the output and VerifyCSharpEnvironment()
             fails at cook. -->
        <IsPublishable>true</IsPublishable>
    </PropertyGroup>

    <PropertyGroup>
        <UETargetType Condition="'$(UETargetType)' == ''">Editor</UETargetType>
        <DefineConstants Condition="'$(UETargetType)' == 'Editor'">WITH_EDITOR</DefineConstants>
        <DefineConstants Condition="'$(DefineAdditionalConstants)' != ''">$(DefineConstants);$(DefineAdditionalConstants)</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnrealSharp.Core\UnrealSharp.Core.csproj"/>
        <ProjectReference Include="..\UnrealSharp.Log\UnrealSharp.Log.csproj"/>
        <ProjectReference Include="..\UnrealSharp\UnrealSharp.csproj" />
        
        <ProjectReference Include="..\UnrealSharp.SourceGenerators\UnrealSharp.SourceGenerators.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        
        <PackageReference Include="Microsoft.Build.Locator" Condition="'$(UETargetType)' == 'Editor'" />
    </ItemGroup>

    
</Project>
