<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
    <UnrealSharpPluginDir>$(MSBuildThisFileDirectory)</UnrealSharpPluginDir>
    <UnrealSharpAnalyzerDirectory Condition="'$(UnrealSharpAnalyzerDirectory)' == ''">$(UnrealSharpPluginDir)Binaries\Managed\netstandard2.0</UnrealSharpAnalyzerDirectory>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.AOT.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.AOT.props')" />
  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.Build.props" Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.Build.props')" />

  <ItemGroup>
  
    <Reference Include="UnrealSharp">
      <HintPath>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\UnrealSharp.dll</HintPath>
    </Reference>
	
	<Reference Include="UnrealSharp.Binds">
      <HintPath>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\UnrealSharp.Binds.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Core">
      <HintPath>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\UnrealSharp.Core.dll</HintPath>
    </Reference>
	
    <Reference Include="UnrealSharp.Log">
      <HintPath>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\UnrealSharp.Log.dll</HintPath>
    </Reference>

    <Reference Include="UnrealSharp.Plugins">
      <HintPath>$(UnrealSharpPluginDir)Binaries\Managed\$(TargetFramework)\UnrealSharp.Plugins.dll</HintPath>
    </Reference>
    
  </ItemGroup>

  <ItemGroup Condition="'$(SkipIncludeAnalyzers)' == ''">
    <Analyzer Include="$(UnrealSharpAnalyzerDirectory)\Newtonsoft.Json.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpAnalyzerDirectory)\UnrealSharp.GlueGenerator.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpAnalyzerDirectory)\UnrealSharp.Analyzers.dll" Private="false" CopyToPublishDirectory="Never" />
    <Analyzer Include="$(UnrealSharpAnalyzerDirectory)\UnrealSharp.CodeFixer.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(UnrealSharpAnalyzerDirectory)\UnrealSharp.SourceGenerators.dll" Private="false" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Import Project="$(UnrealSharpPluginDir)UnrealSharp.Mobile.targets"
          Condition="Exists('$(UnrealSharpPluginDir)UnrealSharp.Mobile.targets')" />
</Project>
